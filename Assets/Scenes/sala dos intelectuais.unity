  m_EditorClassIdentifier: Assembly-CSharp::Luminaria
  nomeIntelectual: Olivia Rodrigo
  biografia: "Olivia Rodrigo \xE9 uma cantora, compositora e atriz norte-americana.\r\nEla
    ganhou grande destaque em 2021 com a m\xFAsica \"drivers license\",\r\nque impulsionou
    sua carreira musical. Seu primeiro \xE1lbum, SOUR, teve\r\ngrande sucesso e recebeu
    reconhecimento no Grammy Awards. Em seguida, ela lan\xE7ou GUTS, mostrando uma
    sonoridade com influ\xEAncias de pop e rock."
  controleLuminarias: {fileID: 1976160487}
