  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Luminaria
  nomeIntelectual: Taylor Swift
  biografia: "Taylor Swift \xE9 uma cantora e compositora norte-americana, nascida
    em\r\n13 de dezembro de 1989, em Reading, Pensilv\xE2nia. Ela iniciou sua carreira\r\nna
    m\xFAsica country ainda adolescente e posteriormente passou a explorar\r\ndiferentes
    estilos musicais, principalmente o pop. Ao longo de sua\r\ncarreira, destacou-se
    tamb\xE9m pela composi\xE7\xE3o de suas pr\xF3prias m\xFAsicas.\r\nSeu trabalho
    recebeu diversos pr\xEAmios e reconhecimentos, incluindo\r\nv\xE1rios Grammys."
  controleLuminarias: {fileID: 1976160487}
